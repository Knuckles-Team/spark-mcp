# --- Spark Connect (gRPC) endpoint — the spark-runner pod's Connect server ---
SPARK_CONNECT_URL=sc://spark-connect.apps.svc:15002
SPARK_SUBMIT_TIMEOUT_S=300

# --- Lakehouse Iceberg catalog identity (already registered server-side; these
# document/verify the invariant client-side — same invalid_scope landmine as
# Trino/Lakekeeper if scope is ever left at the shared-client default "catalog") ---
SPARK_LAKEHOUSE_CATALOG=lakehouse
SPARK_LAKEHOUSE_SCOPE=lakekeeper

# --- Write gate (DEC-CA-07 client-side enforcement, same mechanism as
# egeria-mcp's EGERIA_ENABLE_WRITE) — spark_submit_transform/spark_rerun_transform
# refuse, not silently execute, unless this is true ---
SPARK_ENABLE_TRANSFORMS=False

# --- Identity propagation (disabled by default — the deployed spark-connect
# Service is plaintext gRPC; attaching a bearer token forces a TLS channel the
# endpoint does not speak today. See spark_mcp/auth.py's module docstring). ---
SPARK_CONNECT_ATTACH_IDENTITY_TOKEN=False
SPARK_CONNECT_USE_SSL=False
SPARK_SERVICE_CLIENT_ID=spark-service
SPARK_SERVICE_CLIENT_SECRET=
SPARK_OAUTH_SCOPE=lakekeeper
SPARK_OAUTH_TOKEN_URL=
SPARK_KEYCLOAK_URL=http://localhost:8080
SPARK_KEYCLOAK_REALM=homelab

# --- Tool Toggle Switches (set False to disable) ---
SPARKTOOL=True
INGESTTOOL=True
